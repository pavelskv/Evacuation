[node name="RichTextLabelTask" type="RichTextLabel" parent="Control/VBoxContainer/MarginContainerCommon/HBoxContainer/MarginContainerPanel/Panel/VBoxContainer/MarginContainerPanelPic/MarginContainerTask/HBoxContainer" unique_id=674405024]
layout_mode = 2
