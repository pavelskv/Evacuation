theme_override_font_sizes/font_size = 30
text = "руководствуясь знаниями о порядке действий при эвакуации по сигналу пожарной тревоги, необходимо отключить электроприборы, взять личные вещи, закрыть за собой окна и дверь кабинета.
Далее, ориентируясь на указатели направлений к выходам, следует покинуть здание по маршруту, указанному в плане эвакуации."
autowrap_mode = 3

